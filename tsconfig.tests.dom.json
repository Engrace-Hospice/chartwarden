{
  "$schema": "https://json.schemastore.org/tsconfig",
  "_comment": "WardenX \u2014 typecheck program for the BROWSER test tree (F-098): the `*.dom.test.tsx` suites vitest runs under jsdom, plus every suite in a frontend workspace, which reaches React components either way. `lib: DOM` and `jsx` live HERE and only here, so they cannot reach the node program (scripts/check-test-typecheck-coverage.ts asserts the two are disjoint).",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "types": [
      "node",
      "vite/client",
      "@testing-library/jest-dom/vitest"
    ],
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "apps/**/*.dom.test.tsx",
    "packages/**/*.dom.test.tsx",
    "apps/web/**/*.test.ts",
    "apps/web/**/*.test.tsx",
    "apps/admin/**/*.test.ts",
    "apps/admin/**/*.test.tsx",
    "apps/portal/**/*.test.ts",
    "apps/portal/**/*.test.tsx",
    "packages/ui/**/*.test.ts",
    "packages/admin-ui-shell/**/*.test.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "scripts/__fixtures__/**",
    "**/src/**"
  ]
}
