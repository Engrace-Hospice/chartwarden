# Keep the WardenX corpus source-only (specs + fitness kit).
# Tooling/build artifacts are reproducible via `bun install`.
node_modules/
bun.lock
.DS_Store
.claude/settings.local.json

# Generated build artifact — the implementation-repo starter, regenerable from the
# manifest/docs via the scaffold step (not corpus content). Specific name, not *.zip,
# so the authored WARDENX_UI_SCREEN_SPECS_v2.zip spec artifact stays tracked.
wardenx-impl-starter.zip

# Module spec bundles — regenerable by re-zipping the WARDENX_MODULE_*.md / T-29.*.md
