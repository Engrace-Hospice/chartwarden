# Keep the WardenX corpus source-only (specs + fitness kit).
# Tooling/build artifacts are reproducible via `bun install`.
node_modules/
.DS_Store
.vscode/

# AI coding-agent tool config/state — personal/local, not part of the WardenX corpus.
.agents/
.claude/
.codex/
.cursor/

# Local scratch file (provenance untracked; not part of the corpus).
scratchpad_list.txt

# TypeScript project-reference build output (regenerable via `tsc -b`).
dist/
*.tsbuildinfo

# Local env (committed template is .env.example).
# The glob is the load-bearing line: `.env` + `.env.local` alone left `.env.bak.<epoch>` — a real file in
# this working tree holding a live BETTER_AUTH_SECRET and both DB URLs — one `git add -A` from being
# committed. Anything that starts with `.env` is a secret unless it is the committed template.
.env
.env.*
!.env.example
# The production template is the contract for bootstrap-vps.sh / DR rebuilds (GAP-176); a real
# .env.production never has the `.example` suffix and stays ignored by the glob above.
!deploy/production/.env.production.example

# Local dev credentials written by `bun run db:seed` (never commit secrets).
CREDENTIALS.local.md

# Phase 0: bun.lock IS committed (acceptance #1 — `bun install` resolves from a
# committed lockfile on a clean checkout). Do NOT ignore it.

# Generated build artifact — the implementation-repo starter, regenerable from the
# manifest/docs via the scaffold step (not corpus content).
wardenx-impl-starter.zip

# Generated bundles — regenerable from the spec sources in docs/modules/ (module specs +
# module-29-tasks/). Named individually rather than globbed as *.zip because these entries
# predate the removal of the two zips that used to be the reason for the distinction
# (WARDENX_PROJECT_STARTER.zip, WARDENX_UI_SCREEN_SPECS_v5.zip); the corpus itself lives in
# docs/, and nothing in the repo is generated FROM a zip.
WARDENX_MODULES_01-10.zip
WARDENX_MODULES_11-20.zip
WARDENX_MODULES_21-30.zip
WARDENX_MODULES_31-40.zip
WARDENX_MODULE_29_TASKS_T29.zip

# wardenx-piv: per-run resolved plan path + module scope (workflow setup node)
.archon/run-plan.txt
.archon/run-scope.txt
.archon/commit-msg.txt
.archon/pr-body.md

# Storybook build output
storybook-static/

# Playwright E2E run artifacts (WX-PR-018) — traces/screenshots/video on failure, HTML report.
e2e/playwright-report/
e2e/test-results/
e2e/blob-report/

# Executed and in-progress legal instruments (NDAs, BAAs, contractor agreements). These carry
# counterparty PII — home addresses, signatures, entity details — and git history is permanent,
# so a single committed draft is effectively undeletable. Keep them out of the repo entirely and
# store them in the org's document system of record instead.
legal/

# Stray run artifacts from audit/gate scripts
audit_stderr.log
scratchpad/

# Downloaded reference releases (scripts/db/load-icd10cm.ts)
.cache/

# graphify generated artifacts: regenerable locally, too large for git (graph.json was 78 MB)
graphify-out/graph.json
graphify-out/graph.html
graphify-out/cache/
