# Who must review a change to the agent harness, the compliance record and the secret scanners.
# Takes effect once the `main` ruleset (.github/rulesets/main.json, applied by hand per
# docs/runbooks/main-branch-protection.md) requires code-owner review; until then it documents the
# owner and `arch:compliance` / `arch:branch-protection` keep it from being deleted.
/.claude/settings.json     @fabwebdev
/.claude/rules/            @fabwebdev
/.claude/agents/           @fabwebdev
/.claude/skills/           @fabwebdev
/.agents/rules/            @fabwebdev
/.agents/agents/           @fabwebdev
/.agents/skills/           @fabwebdev
/.codex/hooks.json         @fabwebdev
/bunfig.toml               @fabwebdev
/scripts/harness/          @fabwebdev
/scripts/check-compliance-controls.ts @fabwebdev
/scripts/check-vendor-agreements.ts @fabwebdev
/compliance/               @fabwebdev
/.githooks/                @fabwebdev
/.gitleaks.toml            @fabwebdev
/.github/CODEOWNERS        @fabwebdev
/.github/workflows/        @fabwebdev
/.github/rulesets/         @fabwebdev
# What decides what reaches production (CW-CM-01): the agent instructions, the deploy path, the gates that
# gate it. `arch:branch-protection` fails when one of these loses its owner.
/CLAUDE.md                 @fabwebdev
/AGENTS.md                 @fabwebdev
/.trivyignore.yaml         @fabwebdev
/deploy/production/        @fabwebdev
/scripts/db/migrate.ts     @fabwebdev
/scripts/check-branch-protection.ts @fabwebdev
/scripts/verify-branch-protection.ts @fabwebdev
# The contingency-plan evidence (CW-CP-01): a restore-drill record and the check that counts one decide whether the overdue
# alarm is silent, so neither changes without the owner (once the main ruleset's code-owner review is applied:
# docs/runbooks/main-branch-protection.md; until then a record is a self-attested file).
/audit/restore-drill/      @fabwebdev
/scripts/backup/check-drill-overdue.ts @fabwebdev
/scripts/check-hooks-installed.ts   @fabwebdev
/scripts/check-release-gate.ts      @fabwebdev
/scripts/check-merge-artifacts.ts   @fabwebdev
/scripts/run-fitness-gates.ts       @fabwebdev
/scripts/check-sast.ts              @fabwebdev
# Every PR-gate check runs as `bun run <script>`, and the script bodies are in package.json; gitleaks reads
# .gitleaksignore from the scanned tree, so a PR that adds one silences its own finding.
/package.json              @fabwebdev
/.gitleaksignore           @fabwebdev
