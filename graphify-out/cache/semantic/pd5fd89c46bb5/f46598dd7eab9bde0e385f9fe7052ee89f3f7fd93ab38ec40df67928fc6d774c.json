{"nodes": [{"id": "docs_modules_wardenx_module_02_identity_spec_v0_4_module_2_identity", "label": "Module 2 \u2014 Identity & Organization", "file_type": "document", "source_file": "docs/modules/WARDENX_MODULE_02_IDENTITY_SPEC_v0_4.md", "source_location": "\u00a71.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owns who a user is and which organization a session operates in; owns session machinery/behavior, not the M1-owned tables, reaching them only through M1's exported repositories."}, {"id": "docs_modules_wardenx_module_02_identity_spec_v0_4_step_up_policy", "label": "STEP_UP_POLICY (platform floor, tenant-tighten-only, D9)", "file_type": "concept", "source_file": "docs/modules/WARDENX_MODULE_02_IDENTITY_SPEC_v0_4.md", "source_location": "\u00a74.3 / \u00a711 D9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Platform floor {webauthn, totp} with 300s freshness; SMS is deliberately absent (no public-key proof of possession, SIM-swap exposure). The intersect-on-tighten semantic is what makes tenant override safe \u2014 a tenant can shrink the trust surface but never expand it."}, {"id": "docs_modules_wardenx_module_02_identity_spec_v0_4_session_policy", "label": "SESSION_POLICY (one constant for all timeouts, D1)", "file_type": "concept", "source_file": "docs/modules/WARDENX_MODULE_02_IDENTITY_SPEC_v0_4.md", "source_location": "\u00a711 D1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Architecture \u00a77's stricter 15-minute idle governs over Security Hardening's 30-minute for shared clinical workstations; screen-lock and idle are distinct layers."}, {"id": "docs_modules_wardenx_module_02_identity_spec_v0_4_session_classes", "label": "Four Session Classes (staff, auditor, external_collaborator, funeral_home)", "file_type": "concept", "source_file": "docs/modules/WARDENX_MODULE_02_IDENTITY_SPEC_v0_4.md", "source_location": "\u00a71.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_modules_wardenx_module_02_identity_spec_v0_4_login_mfa_counts_as_step_up", "label": "Login-MFA-Counts-As-Step-Up Rule (D10)", "file_type": "rationale", "source_file": "docs/modules/WARDENX_MODULE_02_IDENTITY_SPEC_v0_4.md", "source_location": "\u00a711 D10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A clinician who just authenticated with WebAuthn to start a shift should be able to immediately rotate a credential or accept an SUD-unredact request without a second challenge; the 5-minute window keeps a long-lived session from drifting past freshness. External-collaborator and funeral-home sessions get NULL, a hard boundary against privileged action."}, {"id": "docs_modules_wardenx_module_02_identity_spec_v0_4_auditor_session_minter", "label": "AuditorSessionMinter seam (M2 mints, M3 scopes \u2014 D4)", "file_type": "concept", "source_file": "docs/modules/WARDENX_MODULE_02_IDENTITY_SPEC_v0_4.md", "source_location": "\u00a74.7 / \u00a711 D4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "M2 owns session mechanics; M3 owns engagement scope and window. Boot validation means an engagement that cannot mint a session fails at startup rather than at first use."}, {"id": "docs_modules_wardenx_module_02_identity_spec_v0_4_one_identity_many_memberships", "label": "One-Identity-Many-Memberships Model", "file_type": "concept", "source_file": "docs/modules/WARDENX_MODULE_02_IDENTITY_SPEC_v0_4.md", "source_location": "\u00a71.1 / \u00a71.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Traveling/contract clinicians legitimately work at more than one agency; authentication factors are user-level and shared, authorization is not. Competitors use single-org logins with bolt-on MFA and force manual account juggling."}, {"id": "docs_modules_wardenx_module_02_identity_spec_v0_4_hibp_breach_check", "label": "HIBP k-anonymity Breached-Password Check (D5)", "file_type": "concept", "source_file": "docs/modules/WARDENX_MODULE_02_IDENTITY_SPEC_v0_4.md", "source_location": "\u00a711 D5 / M02-F10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only a SHA-1 prefix leaves the perimeter, so no PHI and no BAA required; wrapped in an adapter with a circuit breaker that accepts the password and flags for async re-check when HIBP is down."}], "edges": [{"source": "docs_modules_wardenx_module_02_identity_spec_v0_4_module_2_identity", "target": "docs_modules_wardenx_module_01_foundation_spec_v0_4_module_1_foundation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/modules/WARDENX_MODULE_02_IDENTITY_SPEC_v0_4.md", "source_location": "Depends on: 1 (Foundation)", "weight": 1.0}, {"source": "docs_modules_wardenx_module_02_identity_spec_v0_4_module_2_identity", "target": "docs_modules_wardenx_module_02_identity_spec_v0_4_step_up_policy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/modules/WARDENX_MODULE_02_IDENTITY_SPEC_v0_4.md", "source_location": "\u00a74.3", "weight": 1.0}, {"source": "docs_modules_wardenx_module_02_identity_spec_v0_4_module_2_identity", "target": "docs_modules_wardenx_module_02_identity_spec_v0_4_session_policy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/modules/WARDENX_MODULE_02_IDENTITY_SPEC_v0_4.md", "source_location": "\u00a711 D1", "weight": 1.0}, {"source": "docs_modules_wardenx_module_02_identity_spec_v0_4_module_2_identity", "target": "docs_modules_wardenx_module_02_identity_spec_v0_4_session_classes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/modules/WARDENX_MODULE_02_IDENTITY_SPEC_v0_4.md", "source_location": "\u00a71.1", "weight": 1.0}, {"source": "docs_modules_wardenx_module_02_identity_spec_v0_4_module_2_identity", "target": "docs_modules_wardenx_module_02_identity_spec_v0_4_one_identity_many_memberships", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/modules/WARDENX_MODULE_02_IDENTITY_SPEC_v0_4.md", "source_location": "\u00a71.1", "weight": 1.0}, {"source": "docs_modules_wardenx_module_02_identity_spec_v0_4_module_2_identity", "target": "docs_modules_wardenx_module_02_identity_spec_v0_4_hibp_breach_check", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/modules/WARDENX_MODULE_02_IDENTITY_SPEC_v0_4.md", "source_location": "\u00a711 D5", "weight": 1.0}, {"source": "docs_modules_wardenx_module_02_identity_spec_v0_4_step_up_policy", "target": "docs_modules_wardenx_module_02_identity_spec_v0_4_login_mfa_counts_as_step_up", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/modules/WARDENX_MODULE_02_IDENTITY_SPEC_v0_4.md", "source_location": "\u00a711 D10", "weight": 1.0}, {"source": "docs_modules_wardenx_module_02_identity_spec_v0_4_auditor_session_minter", "target": "docs_modules_wardenx_module_01_foundation_spec_v0_4_seam_registry", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/modules/WARDENX_MODULE_02_IDENTITY_SPEC_v0_4.md", "source_location": "\u00a711 D4 \u2014 boot-validated seam", "weight": 1.0}], "hyperedges": []}