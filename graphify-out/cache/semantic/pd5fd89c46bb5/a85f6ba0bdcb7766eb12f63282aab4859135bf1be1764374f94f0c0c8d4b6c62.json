le_01_foundation_spec_v0_4_envelope_encryption", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/modules/WARDENX_MODULE_01_FOUNDATION_SPEC_v0_4.md", "source_location": "\u00a711.1 D1", "weight": 1.0}, {"source": "docs_modules_wardenx_module_01_foundation_spec_v0_4_module_1_foundation", "target": "docs_modules_wardenx_module_01_foundation_spec_v0_4_outbox_dispatcher", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/modules/WARDENX_MODULE_01_FOUNDATION_SPEC_v0_4.md", "source_location": "\u00a74.8 / D4", "weight": 1.0}, {"source": "docs_modules_wardenx_module_01_foundation_spec_v0_4_module_1_foundation", "target": "docs_modules_wardenx_module_01_foundation_spec_v0_4_feature_flag_governance", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/modules/WARDENX_MODULE_01_FOUNDATION_SPEC_v0_4.md", "source_location": "\u00a713", "weight": 1.0}, {"source": "docs_modules_wardenx_module_01_foundation_spec_v0_4_module_1_foundation", "target": "docs_modules_wardenx_module_01_foundation_spec_v0_4_two_tier_session_storage", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/modules/WARDENX_MODULE_01_FOUNDATION_SPEC_v0_4.md", "source_location": "\u00a711.1 D2", "weight": 1.0}, {"source": "docs_modules_wardenx_module_01_foundation_spec_v0_4_outbox_event_catalog", "target": "docs_modules_wardenx_module_03_authorization_spec_v0_3_mn_namespace_ownership", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/modules/WARDENX_MODULE_01_FOUNDATION_SPEC_v0_4.md", "source_location": "\u00a711.2 D8 \u2014 enforce the M3 v0.3 D9 'modules own their mN. namespace' convention at the event level", "weight": 1.0}, {"source": "docs_modules_wardenx_module_01_foundation_spec_v0_4_outbox_event_catalog", "target": "docs_modules_wardenx_module_04_audit_spec_v0_4_action_catalog_namespace", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/modules/WARDENX_MODULE_01_FOUNDATION_SPEC_v0_4.md", "source_location": "\u00a711.2 D8 \u2014 'mirroring M4 v0.3's audit-action catalog approach'", "weight": 1.0}, {"source": "docs_modules_wardenx_module_01_foundation_spec_v0_4_organization_settings_registry", "target": "docs_modules_wardenx_module_05_patient_spec_v0_4_module_5_patient", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/modules/WARDENX_MODULE_01_FOUNDATION_SPEC_v0_4.md", "source_location": "\u00a711.2 D6 \u2014 hosts M5's hl7_internal_mrn_authority uniqueness guard", "weight": 1.0}], "hyperedges": [{"id": "boot_time_seam_registry_fail_loud_pattern", "label": "Boot-Time Seam Registry Fail-Loud Pattern", "nodes": ["docs_modules_wardenx_module_01_foundation_spec_v0_4_seam_registry", "docs_modules_wardenx_module_03_authorization_spec_v0_3_required_seams", "docs_modules_wardenx_module_04_audit_spec_v0_4_destruction_certificate_workflow", "docs_modules_wardenx_module_05_patient_spec_v0_4_caseload_provider_seam", "docs_modules_wardenx_module_02_identity_spec_v0_4_auditor_session_minter", "docs_modules_wardenx_module_04_audit_spec_v0_4_boot_registered_seam_inversion"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/modules/WARDENX_MODULE_01_FOUNDATION_SPEC_v0_4.md"}]}