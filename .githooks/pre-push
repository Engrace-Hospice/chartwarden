#!/usr/bin/env bash
# ChartWarden pre-push gate — the free, private-repo alternative to GitHub branch protection.
# Blocks a push that updates `main` unless the full fitness suite passes locally.
# (GitHub branch protection / rulesets require a paid plan on private repos; this hook
#  enforces the same intent on the one path that can bypass PR review: a direct push to main.)
#
# Activate once:  bun run setup:hooks   (or: git config core.hooksPath .githooks)
# Emergency bypass: git push --no-verify   OR   SKIP_FITNESS=1 git push   OR   SKIP_E2E=1 git push
set -euo pipefail

if [ "${SKIP_FITNESS:-}" = "1" ]; then
  echo "pre-push: SKIP_FITNESS=1 set — skipping fitness gate."
  exit 0
fi

PROTECTED="refs/heads/main"
pushing_main=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  [ "$remote_ref" = "$PROTECTED" ] && pushing_main=1
done

# e2e runs on EVERY push (all specs, local stack; no Actions minutes). Bypass: SKIP_E2E=1 git push
if [ "${SKIP_E2E:-}" != "1" ]; then
  E2E_URL="${E2E_BASE_URL:-http://localhost:5173}"
  if ! curl -fsS -o /dev/null --max-time 5 "$E2E_URL"; then
    echo "pre-push: e2e stack not reachable at $E2E_URL — start the Docker stack, or SKIP_E2E=1 git push." >&2
    exit 1
  fi
  echo "pre-push: running Playwright e2e (all specs) against ${E2E_URL}…"
  bun run test:e2e
fi

# Only gate pushes that update main with the fitness suite; feature-branch pushes go through PR CI.
[ "$pushing_main" -eq 0 ] && exit 0

if ! command -v bun >/dev/null 2>&1; then
  echo "pre-push: bun not found — install it or use 'git push --no-verify' deliberately." >&2
  exit 1
fi
if [ ! -d node_modules ]; then
  echo "pre-push: node_modules missing — run 'bun install' first (or 'git push --no-verify')." >&2
  exit 1
fi

echo "pre-push: updating main → running fitness gate (build + arch:fitness + test + audit:deps)…"
bun run build && bun run arch:fitness && bun run test
# GAP-087: dependency advisories are the one gate input that changes WITHOUT the tree changing, so
# a push that alters nothing about dependencies can still be the first push after an advisory lands.
# `audit:deps` reaches the advisory registry; offline it warns rather than blocking (it hard-fails
# only under CI, where a silent skip would be indistinguishable from a pass).
bun run audit:deps
echo "pre-push: ✓ gate green — allowing push to main."
