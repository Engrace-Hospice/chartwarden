#!/usr/bin/env bash
# ChartWarden pre-commit — secrets and PHI-shaped identifiers never enter a commit (CW-SEC-01, CW-CM-02).
# Runs on every commit (humans and agents alike); ~1–3 s on a typical staged set.
#
# Activate once:  bun run setup:hooks
# Emergency bypass is a HUMAN decision: git commit --no-verify (the agent harness refuses it).
set -euo pipefail

if command -v bun >/dev/null 2>&1; then
  bun run scripts/harness/phi-scan.ts --staged
else
  echo "pre-commit: bun not found — PHI scan skipped (CI will run it)." >&2
fi

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact --no-banner --config .gitleaks.toml
else
  echo "pre-commit: gitleaks not installed — secret scan skipped locally (CI runs it). Install v8.30.1: https://github.com/gitleaks/gitleaks/releases" >&2
fi
