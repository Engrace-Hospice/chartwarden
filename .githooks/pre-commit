#!/usr/bin/env bash
# ChartWarden pre-commit — secrets and PHI-shaped identifiers never enter a commit (CW-SEC-01, CW-CM-02).
# Runs on every commit (humans and agents alike); ~1–3 s on a typical staged set.
#
# Activate once:  bun run setup:hooks   (`bun install` does it through `prepare`; `bun run arch:hooks-installed` checks it)
# Emergency bypass is a HUMAN decision: git commit --no-verify (the agent harness refuses it).
#
# FAILS CLOSED: a scanner that is not installed refuses the commit. This hook used to print "skipped" and
# let the commit through, which made the scan optional for anyone without the tool (CW-SEC-01). The
# server-side copy is the `Secret and PHI scan` job in .github/workflows/pr-gate.yml.
set -euo pipefail

missing=0
if ! command -v bun >/dev/null 2>&1; then
  echo "pre-commit: bun not found — the PHI scan cannot run, so this commit is refused. Install bun: https://bun.sh" >&2
  missing=1
fi
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not installed — the secret scan cannot run, so this commit is refused. Install v8.30.1: https://github.com/gitleaks/gitleaks/releases" >&2
  missing=1
fi
if [ "$missing" -ne 0 ]; then
  exit 1
fi

bun run scripts/harness/phi-scan.ts --staged
gitleaks git --pre-commit --staged --redact --no-banner --config .gitleaks.toml
