{
  "tool": "pg_isready",
  "version": "16.13",
  "command": "pg_isready --help; getopt behaviour probes against 127.0.0.1 port 1",
  "options": [
    {
      "name": "dbname",
      "short": "d",
      "takesValue": true,
      "role": "string"
    },
    {
      "name": "quiet",
      "short": "q",
      "takesValue": false
    },
    {
      "name": "version",
      "short": "V",
      "takesValue": false,
      "argv1Only": true
    },
    {
      "name": "help",
      "short": "?",
      "takesValue": false,
      "argv1Only": true
    },
    {
      "name": "host",
      "short": "h",
      "takesValue": true,
      "role": "host"
    },
    {
      "name": "port",
      "short": "p",
      "takesValue": true
    },
    {
      "name": "timeout",
      "short": "t",
      "takesValue": true
    },
    {
      "name": "username",
      "short": "U",
      "takesValue": true
    }
  ],
  "abbreviations": [
