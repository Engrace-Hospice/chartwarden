      "prefix": "d",
      "outcome": "string"
    },
    {
      "prefix": "db",
      "outcome": "string"
    },
    {
      "prefix": "h",
      "outcome": "host"
    },
    {
      "prefix": "ho",
      "outcome": "host"
    },
    {
      "prefix": "p",
      "outcome": "value"
    },
    {
      "prefix": "po",
      "outcome": "value"
    },
    {
      "prefix": "q",
      "outcome": "flag"
    },
    {
      "prefix": "qu",
      "outcome": "flag"
    },
    {
      "prefix": "t",
      "outcome": "value"
    },
    {
      "prefix": "ti",
      "outcome": "value"
    },
    {
      "prefix": "u",
      "outcome": "value"
    },
    {
      "prefix": "us",
      "outcome": "value"
    }
  ]
}
