# WardenX staff SPA — production image.
#
# The API and worker share the root Dockerfile. This separate, multi-stage image builds the Vite
# staff app once and serves only its static output with the unprivileged nginx image.
FROM oven/bun:1.3.5-slim AS build
WORKDIR /app

COPY --chown=bun:bun . .
RUN bun install --frozen-lockfile
RUN bun run --cwd apps/web build:app

FROM nginxinc/nginx-unprivileged:1.29-alpine

# The pinned Nginx image is rebuilt independently of Alpine security releases. Refresh its runtime
# packages at build time so published web images include available fixes such as PCRE2 10.49.
USER root
RUN apk upgrade --no-cache
USER nginx

COPY deploy/production/web-nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/production/web-security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY --from=build /app/apps/web/dist/app /usr/share/nginx/html

EXPOSE 8080
