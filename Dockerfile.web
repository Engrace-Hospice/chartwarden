# ChartWarden staff SPA — production image.
#
# The API and worker share the root Dockerfile. This separate, multi-stage image builds the Vite
# staff app once and serves only its static output with the unprivileged nginx image.
FROM oven/bun:1.3.5-slim AS build
WORKDIR /app

COPY --chown=bun:bun . .
RUN bun install --frozen-lockfile
# ADR-0049: the `app.<base>` landing is recognised by this build-time value (the backend's TENANT_BASE_DOMAIN); empty on the demo.
ARG VITE_TENANT_BASE_DOMAIN=""
ENV VITE_TENANT_BASE_DOMAIN=${VITE_TENANT_BASE_DOMAIN}
RUN bun run --cwd apps/web build:app
# ADR-0049 Phase 5: the patient/family portal ships in this image under /portal/ (its default Vite base), so one
# web tier answers every tenant host. Staff app at /, portal at /portal/ - see web-nginx.conf.
RUN bun run --cwd apps/portal build:app

FROM nginxinc/nginx-unprivileged:1.29-alpine

# The pinned Nginx image is rebuilt independently of Alpine security releases. Refresh its runtime
# packages at build time so published web images include available fixes such as PCRE2 10.49.
USER root
RUN apk upgrade --no-cache

COPY deploy/production/web-nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/production/web-security-headers.conf /etc/nginx/snippets/security-headers.conf
# ADR-0049: the real environment pins the CSP's `img-src`/`frame-src` to its object-storage origin instead of any `https:`
# host (presigned previews load from there). Empty on the demo, which keeps the shared snippet unchanged.
ARG CSP_STORAGE_ORIGIN=""
RUN case "$CSP_STORAGE_ORIGIN" in \
      "") ;; \
      https://*[!a-z0-9.:-]* | https://) echo "CSP_STORAGE_ORIGIN must be a bare https origin" >&2; exit 1 ;; \
      https://*) sed -i "s# https:;# ${CSP_STORAGE_ORIGIN};#g" /etc/nginx/snippets/security-headers.conf \
                 && ! grep -q ' https:;' /etc/nginx/snippets/security-headers.conf ;; \
      *) echo "CSP_STORAGE_ORIGIN must be a bare https origin" >&2; exit 1 ;; \
    esac
USER nginx

COPY --from=build /app/apps/web/dist/app /usr/share/nginx/html
COPY --from=build /app/apps/portal/dist/app /usr/share/nginx/html/portal

EXPOSE 8080
