{
  "name": "wardenx",
  "private": true,
  "type": "module",
  "description": "WardenX - multi-tenant hospice EHR SaaS. Architecture-fitness kit, spec corpus, and staged implementation monorepo.",
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "setup:hooks": "git config core.hooksPath .githooks && echo 'core.hooksPath -> .githooks'",
    "db:up": "docker start wardenx-postgres 2>/dev/null || docker run -d --name wardenx-postgres -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=wardenx -p 5440:5432 -v wardenx-pgdata:/var/lib/postgresql pgvector/pgvector:pg18",
    "db:down": "docker stop wardenx-postgres",
    "db:migrate": "bun run scripts/db/migrate.ts",
    "db:seed": "bun run scripts/db/seed.ts",
    "db:sync:permissions": "bun --env-file=.env run scripts/db/sync-permission-catalog.ts",
    "db:seed:patients": "bun run scripts/db/seed-patients.ts",
    "db:seed:clinical": "bun run scripts/db/seed-clinical.ts",
    "db:seed:mdm": "bun run scripts/db/seed-mdm.ts",
    "db:seed:census": "bun run scripts/db/seed-census-active.ts",
    "db:reset": "docker rm -f wardenx-postgres 2>/dev/null; docker volume rm wardenx-pgdata 2>/dev/null; bun run db:up && sleep 3 && bun run db:migrate && bun run db:seed && bun run db:seed:patients && bun run db:seed:clinical && bun run db:seed:mdm && bun run db:seed:census",
    "dev:backend": "cd apps/backend && bun run dev",
    "dev:web": "cd apps/web && bun run dev",
    "dev": "bun run dev:backend & bun run dev:web",
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty",
    "clean": "tsc -b --clean",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:rls:live": "vitest run packages/db/migrations/__tests__/rls-isolation.live.test.ts",
    "test:rls:live:m39": "vitest run packages/db/migrations/__tests__/m39-rls-isolation.live.test.ts",
    "test:rls:live:m34": "vitest run packages/db/migrations/__tests__/m34-rls-isolation.live.test.ts",
    "test:rls:live:m33": "vitest run packages/db/migrations/__tests__/m33-rls-isolation.live.test.ts",
    "test:rls:live:m30": "vitest run packages/db/migrations/__tests__/m30-rls-isolation.live.test.ts",
    "test:rls:live:m2": "vitest run packages/db/migrations/__tests__/m2-rls-isolation.live.test.ts",
    "test:rls:live:m5": "vitest run packages/db/migrations/__tests__/m5-rls-isolation.live.test.ts",
    "test:rls:live:m6": "vitest run packages/db/migrations/__tests__/m6-rls-isolation.live.test.ts",
    "test:m6:read:live": "vitest run apps/backend/__tests__/m6-admission-read-service.live.test.ts",
    "test:m7:read:live": "vitest run apps/backend/__tests__/m7-care-plan-read-service.live.test.ts",
    "test:m9:read:live": "vitest run apps/backend/__tests__/m9-assessments-read-service.live.test.ts",
    "test:m10:read:live": "vitest run apps/backend/__tests__/m10-hope-read-service.live.test.ts",
    "test:m11:read:live": "vitest run apps/backend/__tests__/m11-orders-read-service.live.test.ts",
    "test:m12:read:live": "vitest run apps/backend/__tests__/m12-dosespot-read-service.live.test.ts",
    "test:m13:read:live": "vitest run apps/backend/__tests__/m13-emar-read-service.live.test.ts",
    "test:m14:read:live": "vitest run apps/backend/__tests__/m14-idg-read-service.live.test.ts",
    "test:m17:read:live": "vitest run apps/backend/__tests__/m17-scheduling-read-service.live.test.ts",
    "test:m18:read:live": "vitest run apps/backend/__tests__/m18-evv-read-service.live.test.ts",
    "test:m22:read:live": "vitest run apps/backend/__tests__/m22-documents-read-service.live.test.ts",
    "test:rls:live:m7": "vitest run packages/db/migrations/__tests__/m7-rls-isolation.live.test.ts",
    "test:rls:live:m8": "vitest run packages/db/migrations/__tests__/m8-rls-isolation.live.test.ts",
    "test:m8:read:live": "vitest run apps/backend/__tests__/m8-encounters-read-service.live.test.ts",
    "test:rls:live:m9": "vitest run packages/db/migrations/__tests__/m9-rls-isolation.live.test.ts",
    "test:rls:live:m10": "vitest run packages/db/migrations/__tests__/m10-rls-isolation.live.test.ts",
    "test:rls:live:m11": "vitest run packages/db/migrations/__tests__/m11-rls-isolation.live.test.ts",
    "test:rls:live:m12": "vitest run packages/db/migrations/__tests__/m12-rls-isolation.live.test.ts",
    "test:rls:live:m13": "vitest run packages/db/migrations/__tests__/m13-rls-isolation.live.test.ts",
    "test:rls:live:m14": "vitest run packages/db/migrations/__tests__/m14-rls-isolation.live.test.ts",
    "test:rls:live:m17": "vitest run packages/db/migrations/__tests__/m17-rls-isolation.live.test.ts",
    "test:rls:live:m18": "vitest run packages/db/migrations/__tests__/m18-rls-isolation.live.test.ts",
    "test:rls:live:m22": "vitest run packages/db/migrations/__tests__/m22-rls-isolation.live.test.ts",
    "test:rls:live:m1": "vitest run packages/db/migrations/__tests__/m1-rls-isolation.live.test.ts",
    "test:rls:live:m3": "vitest run packages/db/migrations/__tests__/m3-rls-isolation.live.test.ts",
    "test:rls:live:m27": "vitest run packages/db/migrations/__tests__/m27-rls-isolation.live.test.ts",
    "test:rls:live:m36": "vitest run packages/db/migrations/__tests__/m36-rls-isolation.live.test.ts",
    "test:rls:live:m38": "vitest run packages/db/migrations/__tests__/m38-rls-isolation.live.test.ts",
    "test:rls:live:m4": "vitest run packages/db/migrations/__tests__/m4-rls-isolation.live.test.ts",
    "test:rls:live:m15": "vitest run packages/db/migrations/__tests__/m15-rls-isolation.live.test.ts",
    "test:rls:live:m16": "vitest run packages/db/migrations/__tests__/m16-rls-isolation.live.test.ts",
    "test:rls:live:m19": "vitest run packages/db/migrations/__tests__/m19-rls-isolation.live.test.ts",
    "test:rls:live:m20": "vitest run packages/db/migrations/__tests__/m20-rls-isolation.live.test.ts",
    "test:rls:live:m21": "vitest run packages/db/migrations/__tests__/m21-rls-isolation.live.test.ts",
    "test:rls:live:m23": "vitest run packages/db/migrations/__tests__/m23-rls-isolation.live.test.ts",
    "test:rls:live:m24": "vitest run packages/db/migrations/__tests__/m24-rls-isolation.live.test.ts",
    "test:rls:live:m25": "vitest run packages/db/migrations/__tests__/m25-rls-isolation.live.test.ts",
    "test:rls:live:m26": "vitest run packages/db/migrations/__tests__/m26-rls-isolation.live.test.ts",
    "test:rls:live:m32": "vitest run packages/db/migrations/__tests__/m32-rls-isolation.live.test.ts",
    "test:rls:live:m40": "vitest run packages/db/migrations/__tests__/m40-rls-isolation.live.test.ts",
    "test:auth:live": "vitest run apps/backend/__tests__/auth.live.test.ts",
    "scaffold": "bun run scripts/scaffold-from-manifest.ts",
    "scaffold:check": "bun run scripts/scaffold-from-manifest.ts --check",
    "arch:boundaries": "depcruise apps packages --config architecture/.dependency-cruiser.cjs",
    "arch:tables": "bun run scripts/check-table-ownership.ts",
    "arch:tenancy": "bun run scripts/check-tenancy.ts",
    "arch:ddl": "bun run scripts/check-ddl-legality.ts",
    "arch:graph": "depcruise apps packages --config architecture/.dependency-cruiser.cjs --output-type dot | dot -T svg > docs/architecture-graph.svg",
    "arch:gaps": "bun run scripts/check-fitness-gaps.ts",
    "arch:ai-governance": "bun run scripts/check-ai-governance.ts",
    "arch:parity": "bun run scripts/scaffold-from-manifest.ts --check",
    "arch:plan-integrity": "bun run scripts/check-plan-integrity.ts",
    "arch:status-matrix": "bun run scripts/report-implementation-status.ts --check",
    "arch:ui-parity": "bun run scripts/report-ui-parity.ts --check",
    "arch:frame-fidelity": "bun run scripts/report-frame-fidelity.ts --check",
    "arch:design-tokens": "bun run scripts/check-design-tokens.ts",
    "arch:abac-predicates": "bun run scripts/check-abac-predicates.ts",
    "arch:openapi-coverage": "bun run scripts/report-openapi-coverage.ts --check",
    "arch:fitness": "bun run arch:parity && bun run arch:boundaries && bun run arch:tables && bun run arch:tenancy && bun run arch:ddl && bun run arch:gaps && bun run arch:ai-governance && bun run arch:plan-integrity && bun run arch:status-matrix && bun run arch:ui-parity && bun run arch:frame-fidelity && bun run arch:design-tokens && bun run arch:abac-predicates && bun run docs:ui && bun run openapi:check && bun run arch:openapi-coverage && bun run client:check",
    "status:matrix": "bun run scripts/report-implementation-status.ts",
    "ui:parity": "bun run scripts/report-ui-parity.ts",
    "frame:fidelity": "bun run scripts/report-frame-fidelity.ts",
    "frame:fidelity:check": "bun run scripts/report-frame-fidelity.ts --check",
    "docs:ui": "bun run scripts/check-ui-screens.ts",
    "openapi:coverage": "bun run scripts/report-openapi-coverage.ts",
    "openapi:coverage:update": "bun run scripts/report-openapi-coverage.ts --update",
    "openapi:emit": "bun run scripts/openapi/emit.ts",
    "openapi:check": "bun run scripts/openapi/emit.ts --check",
    "client:gen": "openapi-typescript docs/api/openapi.json -o packages/ui/src/core/api/schema.ts",
    "client:check": "openapi-typescript docs/api/openapi.json -o /tmp/wardenx-client-schema.ts && diff -q packages/ui/src/core/api/schema.ts /tmp/wardenx-client-schema.ts || (echo 'FAIL packages/ui/src/core/api/schema.ts is out of date. Run: bun run client:gen' && exit 1)"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.20.1",
    "dependency-cruiser": "^16.10.4",
    "drizzle-kit": "^0.31.10",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.6.25",
    "@sinclair/typebox": "^0.34.52",
    "better-auth": "^1.6.25",
    "bullmq": "^5.81.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.0"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ],
  "overrides": {
    "esbuild": "^0.25.0",
    "find-my-way": "^9.7.0",
    "postcss": "^8.5.18",
    "js-yaml": "^4.3.1",
    "brace-expansion": "^5.0.9",
    "fast-uri": "^4.1.2"
  }
}
