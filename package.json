{
  "name": "wardenx",
  "private": true,
  "type": "module",
  "description": "WardenX - multi-tenant hospice EHR SaaS. Architecture-fitness kit, spec corpus, and staged implementation monorepo.",
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "setup:hooks": "git config core.hooksPath .githooks && echo 'core.hooksPath -> .githooks'",
    "db:up": "docker start wardenx-postgres 2>/dev/null || docker run -d --name wardenx-postgres -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=wardenx -p 5440:5432 -v wardenx-pgdata:/var/lib/postgresql pgvector/pgvector:pg18",
    "db:down": "docker stop wardenx-postgres",
    "db:migrate": "bun run scripts/db/migrate.ts",
    "db:seed": "bun run scripts/db/seed.ts",
    "db:sync:permissions": "bun --env-file=.env run scripts/db/sync-permission-catalog.ts",
    "db:seed:patients": "bun run scripts/db/seed-patients.ts",
    "db:seed:clinical": "bun run scripts/db/seed-clinical.ts",
    "db:seed:mdm": "bun run scripts/db/seed-mdm.ts",
    "db:seed:census": "bun run scripts/db/seed-census-active.ts",
    "db:reset": "docker rm -f wardenx-postgres 2>/dev/null; docker volume rm wardenx-pgdata 2>/dev/null; bun run db:up && sleep 3 && bun run db:migrate && bun run db:seed && bun run db:seed:patients && bun run db:seed:clinical && bun run db:seed:mdm && bun run db:seed:census",
    "dev:backend": "cd apps/backend && bun run dev",
    "dev:web": "cd apps/web && bun run dev",
    "dev": "bun run dev:backend & bun run dev:web",
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty",
    "clean": "tsc -b --clean",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:rls:live": "vitest run packages/db/migrations/__tests__/rls-isolation.live.test.ts",
    "test:rls:live:m34": "vitest run packages/db/migrations/__tests__/m34-rls-isolation.live.test.ts",
    "test:rls:live:m33": "vitest run packages/db/migrations/__tests__/m33-rls-isolation.live.test.ts",
    "test:rls:live:m30": "vitest run packages/db/migrations/__tests__/m30-rls-isolation.live.test.ts",
    "test:rls:live:m7": "vitest run packages/db/migrations/__tests__/m7-rls-isolation.live.test.ts",
    "test:rls:live:m4": "vitest run packages/db/migrations/__tests__/m4-rls-isolation.live.test.ts",
    "test:auth:live": "vitest run apps/backend/__tests__/auth.live.test.ts",
    "scaffold": "bun run scripts/scaffold-from-manifest.ts",
    "scaffold:check": "bun run scripts/scaffold-from-manifest.ts --check",
    "arch:boundaries": "depcruise apps packages --config architecture/.dependency-cruiser.cjs",
    "arch:tables": "bun run scripts/check-table-ownership.ts",
    "arch:tenancy": "bun run scripts/check-tenancy.ts",
    "arch:ddl": "bun run scripts/check-ddl-legality.ts",
    "arch:graph": "depcruise apps packages --config architecture/.dependency-cruiser.cjs --output-type dot | dot -T svg > docs/architecture-graph.svg",
    "arch:gaps": "bun run scripts/check-fitness-gaps.ts",
    "arch:ai-governance": "bun run scripts/check-ai-governance.ts",
    "arch:parity": "bun run scripts/scaffold-from-manifest.ts --check",
    "arch:plan-integrity": "bun run scripts/check-plan-integrity.ts",
    "arch:status-matrix": "bun run scripts/report-implementation-status.ts --check",
    "arch:ui-parity": "bun run scripts/report-ui-parity.ts --check",
    "arch:frame-fidelity": "bun run scripts/report-frame-fidelity.ts --check",
    "arch:design-tokens": "bun run scripts/check-design-tokens.ts",
    "arch:abac-predicates": "bun run scripts/check-abac-predicates.ts",
    "arch:fitness": "bun run arch:parity && bun run arch:boundaries && bun run arch:tables && bun run arch:tenancy && bun run arch:ddl && bun run arch:gaps && bun run arch:ai-governance && bun run arch:plan-integrity && bun run arch:status-matrix && bun run arch:ui-parity && bun run arch:frame-fidelity && bun run arch:design-tokens && bun run arch:abac-predicates && bun run docs:ui && bun run openapi:check",
    "status:matrix": "bun run scripts/report-implementation-status.ts",
    "ui:parity": "bun run scripts/report-ui-parity.ts",
    "frame:fidelity": "bun run scripts/report-frame-fidelity.ts",
    "frame:fidelity:check": "bun run scripts/report-frame-fidelity.ts --check",
    "docs:ui": "bun run scripts/check-ui-screens.ts",
    "openapi:emit": "bun run scripts/openapi/emit.ts",
    "openapi:check": "bun run scripts/openapi/emit.ts --check",
    "client:gen": "openapi-typescript docs/api/openapi.json -o packages/ui/src/core/api/schema.ts",
    "client:check": "openapi-typescript docs/api/openapi.json -o /tmp/wardenx-client-schema.ts && diff -q packages/ui/src/core/api/schema.ts /tmp/wardenx-client-schema.ts || (echo 'FAIL packages/ui/src/core/api/schema.ts is out of date. Run: bun run client:gen' && exit 1)"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "dependency-cruiser": "^16.0.0",
    "drizzle-kit": "^0.31.10",
    "openapi-typescript": "^7.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.0",
    "better-auth": "^1.2.0",
    "bullmq": "^5.34.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.2.0"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ],
  "overrides": {
    "esbuild": "^0.25.0"
  }
}
