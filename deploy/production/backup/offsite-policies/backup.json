{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation", "s3:GetBucketObjectLockConfiguration"],
      "Resource": ["arn:aws:s3:::BACKUP_BUCKET"]
    },
    {
      "Sid": "WriteCurrentVersionsOnly",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:GetObjectRetention"],
      "Resource": ["arn:aws:s3:::BACKUP_BUCKET/*"]
    }
  ]
}
