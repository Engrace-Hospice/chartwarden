# ADR-0049 — settings that turn a production install into the real, per-tenant-subdomain environment.
# Append to (or merge into) .env.production AFTER `.env.production.example` has been rendered; bootstrap-vps.sh does
# this when TENANT_BASE_DOMAIN is set. The demo (chartwarden.cloud) never sets any of these: unset means single-host.
# This environment has its OWN database, object store and secrets; never reuse the demo's .env.production.
#
# The base domain every tenant lives under: <slug>.<base>. A bare registrable domain (no scheme, port or wildcard).
TENANT_BASE_DOMAIN=chartwarden.com
# The fallback origin for links with no tenant (global password reset, find-my-organization). Reserved host.
BETTER_AUTH_URL=https://app.chartwarden.com
# Exact origins the API trusts besides tenant hosts (which are matched by rule, not listed). The APEX must be here,
# or sign-in on the apex fails with INVALID_ORIGIN.
TRUSTED_ORIGINS=https://app.chartwarden.com,https://chartwarden.com
# WebAuthn RP id: the BASE domain, so one passkey works on every tenant host. Effectively permanent once passkeys exist.
PASSKEY_RP_ID=chartwarden.com
WEBAUTHN_RP_ID=chartwarden.com
# ONLY the reverse proxy in front of the API. X-Forwarded-Host (the tenant) is honoured from these peers and from
# nobody else, so the API must not be reachable except through that proxy.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,172.16.0.0/12
# Public object-storage host (reserved name; never a tenant).
STORAGE_PUBLIC_ORIGIN=https://storage.chartwarden.com
# What smoke.sh probes: the app host, the API host (same origin on this install) and a provisioned sample tenant.
CHARTWARDEN_SMOKE_APP_URL=https://app.chartwarden.com
CHARTWARDEN_SMOKE_API_URL=https://app.chartwarden.com
CHARTWARDEN_SMOKE_TENANT_URL=https://sample.chartwarden.com
