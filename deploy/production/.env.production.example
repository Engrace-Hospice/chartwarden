# ChartWarden — production environment template (single-VPS topology, deploy/production/compose.yml).
#
# `bootstrap-vps.sh` copies this to $DEPLOY_DIR/.env.production (mode 0600) on a FRESH host and replaces
# every `REPLACE_WITH_*` token with a freshly generated, INDEPENDENT secret (each occurrence gets its
# own value — secrets are never shared between keys). An existing .env.production is never touched.
# The three domain defaults are rewritten from FRONTEND_DOMAIN / BACKEND_DOMAIN / STORAGE_DOMAIN.
#
# After bootstrap you MUST still edit by hand:
#   - CHARTWARDEN_IMAGE / CHARTWARDEN_WEB_IMAGE (deploy.sh re-pins them to a cosign-verified digest),
#   - the four external-gateway URLs below (the `.example.invalid` hosts are REJECTED at boot),
#   - CHARTWARDEN_SMOKE_EMAIL / CHARTWARDEN_SMOKE_PASSWORD (the synthetic monitor account, see README.md).
#
# Contract: every key apps/backend/src/bootstrap/env.ts requires in production, and every
# `${VAR:?...}` compose.yml reads, is listed here. `deploy/production/__tests__/env-template.test.ts`
# keeps this file, env.ts and compose.yml in sync. NEVER commit a real .env.production.
# NAMING: variables are CHARTWARDEN_*. Releases before the ChartWarden rename read WARDENX_* (see the rollback note in README.md).

# --- Images (immutable GHCR references; deploy.sh pins the digest) ---
CHARTWARDEN_IMAGE=ghcr.io/REPLACE_OWNER/chartwarden:sha-REPLACE
CHARTWARDEN_WEB_IMAGE=ghcr.io/REPLACE_OWNER/chartwarden-web:sha-REPLACE

# --- Datastore credentials (compose builds the connection URLs from these) ---
POSTGRES_PASSWORD=REPLACE_WITH_AT_LEAST_32_CHARACTERS
CHARTWARDEN_APP_PASSWORD=REPLACE_WITH_AT_LEAST_32_CHARACTERS
CHARTWARDEN_PLATFORM_PASSWORD=REPLACE_WITH_AT_LEAST_32_CHARACTERS
CHARTWARDEN_DESTRUCTION_PASSWORD=REPLACE_WITH_AT_LEAST_32_CHARACTERS
# Database name. Changing it on a running host needs the database-rename procedure in INFRA_RENAME_RUNBOOK.md; deploy.sh's
# preflight refuses to run if this database is missing while a legacy `wardenx` one exists.
CHARTWARDEN_DB_NAME=chartwarden

# --- Object storage (MinIO behind host Nginx) ---
MINIO_ROOT_USER=chartwarden-minio-admin
MINIO_ROOT_PASSWORD=REPLACE_WITH_AT_LEAST_32_CHARACTERS
# The app's own MinIO account (scoped to the tenant-* / chartwarden-* buckets; the root account above is for
# provisioning only) and the two bearer tokens the api/worker share with docling-worker and the MinIO
# access-log webhook. `deploy.sh` generates any of these that are missing, once, so they may be left as-is.
MINIO_APP_ACCESS_KEY=chartwarden-app
MINIO_APP_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_CHARACTERS
MINIO_ACCESS_LOG_WEBHOOK_TOKEN=REPLACE_WITH_AT_LEAST_32_CHARACTERS
DOCLING_WORKER_TOKEN=REPLACE_WITH_AT_LEAST_32_CHARACTERS
STORAGE_PUBLIC_ORIGIN=https://storage.chartwarden.cloud

# --- Auth / origins ---
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_CHARACTERS
BETTER_AUTH_URL=https://api.chartwarden.cloud
# The URLs smoke.sh probes after a deploy: the public app/api hosts of this install (bootstrap rewrites them with the domains).
# smoke.sh falls back to https://app./api.chartwarden.cloud when these keys are absent.
CHARTWARDEN_SMOKE_APP_URL=https://app.chartwarden.cloud
CHARTWARDEN_SMOKE_API_URL=https://api.chartwarden.cloud
TRUSTED_ORIGINS=https://app.chartwarden.cloud
# Exact native callback scheme(s), comma-separated. Must match the signed app configuration.
# Choose and review the production value with wardenx-mobile PR C; no wildcard or exp://.
# MOBILE_AUTH_TRUSTED_ORIGINS=chartwarden://
# WebAuthn relying-party ids: the bare registrable host the SPA is served from.
PASSKEY_RP_ID=app.chartwarden.cloud
WEBAUTHN_RP_ID=app.chartwarden.cloud
# CIDRs of the reverse proxy in front of the API (host Nginx on loopback / docker bridge).
TRUSTED_PROXY_CIDRS=127.0.0.1/32,172.16.0.0/12

# --- Application secrets (independent values; rotating one never rotates another) ---
M13_WITNESS_SIGNING_KEY=REPLACE_WITH_AT_LEAST_32_CHARACTERS
# M18 offline-capture payload HMAC. Keep it for at least the receipt lifetime: replacing it in place breaks comparison of historical replays.
EVV_OFFLINE_FINGERPRINT_KEY=REPLACE_WITH_AT_LEAST_32_CHARACTERS
CURSOR_SIGNING_KEY=REPLACE_WITH_AT_LEAST_32_CHARACTERS
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_AT_LEAST_32_CHARACTERS
M24_CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES
# Clearinghouse vendor (ADR-0053 D3): leave unset until an adapter ships (unset = CH_NOT_WIRED, nothing sent).
# A vendor with no adapter in the build refuses to boot; in_memory is refused in production.
# CLEARINGHOUSE_VENDOR=stedi
TWO_FACTOR_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES
MESSAGING_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES
# Platform KEKs, `<kekId>:<base64 32 bytes>` — separate secrets, never reuse one value for both.
M34_TENANT_KEK=kek-1:REPLACE_WITH_BASE64_32_BYTES
M35_PSEUDONYM_KEY_KEK=kek-1:REPLACE_WITH_BASE64_32_BYTES

# --- External gateways (NOT provided by this repo; see PROVISION_GATEWAY.md) ---
# The `.example.invalid` hosts are RFC 2606 placeholders and are REJECTED by the production env
# validator — replace them, or set the matching *_ENABLED switch to `false` to disable the capability.
M23_LAUNCH_GATEWAY_ENABLED=true
M23_X12_GATEWAY_URL=https://x12-gateway.example.invalid
M23_X12_GATEWAY_TOKEN=REPLACE_WITH_AT_LEAST_32_CHARACTERS
M23_MAC_GATEWAY_URL=https://mac-gateway.example.invalid
M23_MAC_GATEWAY_TOKEN=REPLACE_WITH_AT_LEAST_32_CHARACTERS
M34_PROVISION_GATEWAY_ENABLED=true
M34_PROVISION_GATEWAY_URL=https://provision-gateway.example.invalid
M34_PROVISION_GATEWAY_TOKEN=REPLACE_WITH_AT_LEAST_32_CHARACTERS
M34_INVITATION_ACCEPT_URL=https://app.chartwarden.cloud/tenant-invite
FHIR_TOKEN_ENDPOINT_ENABLED=true
FHIR_TOKEN_ENDPOINT_URL=https://api.chartwarden.cloud/fhir/oauth2/token

# --- Transactional email (M36, Postmark; docs/runbooks/transactional-email-postmark.md) ---
# Leave BLANK to keep the provider UNBOUND: production then drops email and the funeral / collaborator / auditor
# invite routes answer 503 LINK_DELIVERY_UNAVAILABLE (fail closed). Set ALL THREE to bind it; a partial set refuses
# to boot. The server token is a secret - never commit it. FROM must be a Postmark-verified sender signature/domain
# (SPF + DKIM + Return-Path), and POSTMARK_SENDER_VERIFIED=true is your attestation that it is.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_ADDRESS=
POSTMARK_SENDER_VERIFIED=
# Optional: Postmark message stream (default "outbound"). POSTMARK_API_BASE_URL is for tests only (default https://api.postmarkapp.com).
# POSTMARK_MESSAGE_STREAM=outbound
# --- Out-of-band alert delivery (M36 GAP-062; Twilio SMS + SOS voice, Postmark alert email, Web Push) ---
# Each channel binds only when ITS variables are all set; an unbound channel stays on the fail-closed deny
# transport (deliveries settle failed/transport_not_configured) and is named in the boot log. Tier-1 SOS voice
# needs the Twilio set below. MESSAGING_WEBHOOK_PUBLIC_BASE_URL is the public origin Twilio calls back (/webhooks/*).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=            # E.164, or set TWILIO_MESSAGING_SERVICE_SID instead
# TWILIO_VOICE_FROM=          # E.164, voice-capable
# MESSAGING_WEBHOOK_PUBLIC_BASE_URL=https://api.example.com
# POSTMARK_WEBHOOK_TOKEN=
# VAPID_PUBLIC_KEY=           # base64url, uncompressed P-256 point
# VAPID_PRIVATE_KEY=          # base64url, 32-byte scalar
# VAPID_SUBJECT=mailto:ops@example.com

# --- Deploy-time synthetic monitor (smoke.sh tier 4) ---
# A least-privilege, non-2FA account that resolves an organization membership and nothing more.
CHARTWARDEN_SMOKE_EMAIL=
CHARTWARDEN_SMOKE_PASSWORD=

# --- Deploy failure alert (optional, #866) ---
# An https:// incoming-webhook URL (Slack-compatible JSON POST). SECRET: it is never printed by deploy.sh. When set,
# any failing deploy posts the commit SHA, failing step, exit code and applied migration filenames (no PHI); exit 75
# is labelled "operator decision required". Leave empty/unset to disable. Delivery failures never fail the deploy.
# DEPLOY_ALERT_WEBHOOK_URL=
