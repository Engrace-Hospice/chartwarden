# WardenX — production environment template (single-VPS topology, deploy/production/compose.yml).
#
# `bootstrap-vps.sh` copies this to $DEPLOY_DIR/.env.production (mode 0600) on a FRESH host and replaces
# every `REPLACE_WITH_*` token with a freshly generated, INDEPENDENT secret (each occurrence gets its
# own value — secrets are never shared between keys). An existing .env.production is never touched.
# The three domain defaults are rewritten from FRONTEND_DOMAIN / BACKEND_DOMAIN / STORAGE_DOMAIN.
#
# After bootstrap you MUST still edit by hand:
#   - WARDENX_IMAGE / WARDENX_WEB_IMAGE (deploy.sh re-pins them to a cosign-verified digest),
#   - the four external-gateway URLs below (the `.example.invalid` hosts are REJECTED at boot),
#   - WARDENX_SMOKE_EMAIL / WARDENX_SMOKE_PASSWORD (the synthetic monitor account, see README.md).
#
# Contract: every key apps/backend/src/bootstrap/env.ts requires in production, and every
# `${VAR:?...}` compose.yml reads, is listed here. `deploy/production/__tests__/env-template.test.ts`
# keeps this file, env.ts and compose.yml in sync. NEVER commit a real .env.production.

# --- Images (immutable GHCR references; deploy.sh pins the digest) ---
WARDENX_IMAGE=ghcr.io/REPLACE_OWNER/wardenx-api:sha-REPLACE
WARDENX_WEB_IMAGE=ghcr.io/REPLACE_OWNER/wardenx-web:sha-REPLACE

# --- Datastore credentials (compose builds the connection URLs from these) ---
POSTGRES_PASSWORD=REPLACE_WITH_AT_LEAST_32_CHARACTERS
WARDENX_APP_PASSWORD=REPLACE_WITH_AT_LEAST_32_CHARACTERS
WARDENX_PLATFORM_PASSWORD=REPLACE_WITH_AT_LEAST_32_CHARACTERS
WARDENX_DESTRUCTION_PASSWORD=REPLACE_WITH_AT_LEAST_32_CHARACTERS

# --- Object storage (MinIO behind host Nginx) ---
MINIO_ROOT_USER=wardenx-minio-admin
MINIO_ROOT_PASSWORD=REPLACE_WITH_AT_LEAST_32_CHARACTERS
# The app's own MinIO account (scoped to the tenant-* / wardenx-* buckets; the root account above is for
# provisioning only) and the two bearer tokens the api/worker share with docling-worker and the MinIO
# access-log webhook. `deploy.sh` generates any of these that are missing, once, so they may be left as-is.
MINIO_APP_ACCESS_KEY=wardenx-app
MINIO_APP_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_CHARACTERS
MINIO_ACCESS_LOG_WEBHOOK_TOKEN=REPLACE_WITH_AT_LEAST_32_CHARACTERS
DOCLING_WORKER_TOKEN=REPLACE_WITH_AT_LEAST_32_CHARACTERS
STORAGE_PUBLIC_ORIGIN=https://storage.wardenx.chartwarden.cloud

# --- Auth / origins ---
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_CHARACTERS
BETTER_AUTH_URL=https://be082026.wardenx.chartwarden.cloud
TRUSTED_ORIGINS=https://wardenx.chartwarden.cloud
# WebAuthn relying-party ids: the bare registrable host the SPA is served from.
PASSKEY_RP_ID=wardenx.chartwarden.cloud
WEBAUTHN_RP_ID=wardenx.chartwarden.cloud
# CIDRs of the reverse proxy in front of the API (host Nginx on loopback / docker bridge).
TRUSTED_PROXY_CIDRS=127.0.0.1/32,172.16.0.0/12

# --- Application secrets (independent values; rotating one never rotates another) ---
M13_WITNESS_SIGNING_KEY=REPLACE_WITH_AT_LEAST_32_CHARACTERS
CURSOR_SIGNING_KEY=REPLACE_WITH_AT_LEAST_32_CHARACTERS
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_AT_LEAST_32_CHARACTERS
M24_CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES
TWO_FACTOR_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES
MESSAGING_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES
# Platform KEKs, `<kekId>:<base64 32 bytes>` — separate secrets, never reuse one value for both.
M34_TENANT_KEK=kek-1:REPLACE_WITH_BASE64_32_BYTES
M35_PSEUDONYM_KEY_KEK=kek-1:REPLACE_WITH_BASE64_32_BYTES

# --- External gateways (NOT provided by this repo; see PROVISION_GATEWAY.md) ---
# The `.example.invalid` hosts are RFC 2606 placeholders and are REJECTED by the production env
# validator — replace them, or set the matching *_ENABLED switch to `false` to disable the capability.
M23_LAUNCH_GATEWAY_ENABLED=true
M23_X12_GATEWAY_URL=https://x12-gateway.example.invalid
M23_X12_GATEWAY_TOKEN=REPLACE_WITH_AT_LEAST_32_CHARACTERS
M23_MAC_GATEWAY_URL=https://mac-gateway.example.invalid
M23_MAC_GATEWAY_TOKEN=REPLACE_WITH_AT_LEAST_32_CHARACTERS
M34_PROVISION_GATEWAY_ENABLED=true
M34_PROVISION_GATEWAY_URL=https://provision-gateway.example.invalid
M34_PROVISION_GATEWAY_TOKEN=REPLACE_WITH_AT_LEAST_32_CHARACTERS
M34_INVITATION_ACCEPT_URL=https://wardenx.chartwarden.cloud/tenant-invitations
FHIR_TOKEN_ENDPOINT_ENABLED=true
FHIR_TOKEN_ENDPOINT_URL=https://be082026.wardenx.chartwarden.cloud/fhir/oauth2/token

# --- Deploy-time synthetic monitor (smoke.sh tier 4) ---
# A least-privilege, non-2FA account that resolves an organization membership and nothing more.
WARDENX_SMOKE_EMAIL=
WARDENX_SMOKE_PASSWORD=
