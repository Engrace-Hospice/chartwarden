{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:CreateBucket", "s3:ListBucket", "s3:GetBucketLocation", "s3:ListBucketVersions"],
      "Resource": ["arn:aws:s3:::tenant-*", "arn:aws:s3:::chartwarden-*"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetLifecycleConfiguration", "s3:PutLifecycleConfiguration"],
      "Resource": ["arn:aws:s3:::tenant-*"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:GetObjectVersion", "s3:DeleteObjectVersion"],
      "Resource": ["arn:aws:s3:::tenant-*/*", "arn:aws:s3:::chartwarden-*/*"]
    }
  ]
}
